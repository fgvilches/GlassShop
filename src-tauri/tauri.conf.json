{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GlassShop",
  "version": "1.0.1",
  "identifier": "io.github.fgvilches.glassshop",
  "build": {
    "frontendDist": "../src/renderer",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "node tauri-dev-server.js"
  },
  "app": {
    "windows": [
      {
        "title": "GlassShop",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "publisher": "Felipe González",
    "copyright": "© 2026 Felipe González",
    "shortDescription": "Liquid Glass download manager for hShop",
    "longDescription": "Browse and download 3DS titles from hShop with a native Liquid Glass interface.",
    "macOS": {
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzREM5N0VCMTUxRjM3QTgKUldTb054OFY2NWZjazVndUhtSmpJN3FWZFJhWHhldFJCOEVHMHlCQWNmR25POW9RUE85cjVjZUUK",
      "endpoints": [
        "https://github.com/fgvilches/GlassShop/releases/latest/download/latest.json"
      ]
    }
  }
}
